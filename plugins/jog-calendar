#!/bin/sh
# jog-calendar — your meetings today, from an iCalendar (.ics) feed.
# Configure via ~/.config/jog/env:
#   JOG_CALENDAR_URL=<private ICS URL>
#     Google Calendar: Settings → your calendar → "Secret address in iCal format"
#     Outlook:         Settings → Calendar → Shared calendars → Publish (ICS)
# Handles one-off events plus simple daily / weekly-by-day recurrences (standups,
# 1:1s). Emits the jog JSON contract; prints [] when unconfigured.

url="${JOG_CALENDAR_URL:-$CALENDAR_URL}"
[ -n "$url" ] || { echo "[]"; exit 0; }
command -v jq >/dev/null 2>&1 || { echo "[]"; exit 0; }
command -v curl >/dev/null 2>&1 || { echo "[]"; exit 0; }

day="${JOG_TODAY:-$(date +%Y-%m-%d)}"
today="$(printf '%s' "$day" | tr -d '-')"
wd="$(date -j -f '%Y-%m-%d' "$day" +%u 2>/dev/null || date -d "$day" +%u 2>/dev/null || date +%u)"
case "$wd" in 1) tc=MO;; 2) tc=TU;; 3) tc=WE;; 4) tc=TH;; 5) tc=FR;; 6) tc=SA;; 7) tc=SU;; *) tc=XX;; esac

curl -s "$url" \
  | tr -d '\r' \
  | sed -e ':a' -e '$!N' -e 's/\n[ \t]//' -e 'ta' -e 'P' -e 'D' \
  | awk -v today="$today" -v tc="$tc" '
      /^BEGIN:VEVENT/ { insum=""; dt=""; tm="all-day"; rr=""; inev=1; next }
      /^END:VEVENT/ {
        if (inev && insum != "") {
          ds = substr(dt, 1, 8); show = 0
          if (rr == "") {
            if (ds == today) show = 1
          } else {
            freq = ""; if (match(rr, /FREQ=[A-Z]+/)) freq = substr(rr, RSTART+5, RLENGTH-5)
            until = ""; if (match(rr, /UNTIL=[0-9]+/)) until = substr(rr, RSTART+6, 8)
            if ((until == "" || until >= today) && ds <= today) {
              if (freq == "DAILY") show = 1
              else if (freq == "WEEKLY") {
                byday = ""; if (match(rr, /BYDAY=[A-Z,]+/)) byday = substr(rr, RSTART+6, RLENGTH-6)
                if (byday != "" && index(byday, tc) > 0) show = 1
              }
            }
          }
          if (show) printf "%s\t%s\n", tm, insum
        }
        inev = 0; next
      }
      inev && /^SUMMARY/  { s = $0; sub(/^SUMMARY[^:]*:/, "", s); insum = s; next }
      inev && /^RRULE/    { r = $0; sub(/^RRULE[^:]*:/, "", r); rr = r; next }
      inev && /^DTSTART/  {
        v = $0; sub(/^DTSTART[^:]*:/, "", v); dt = v
        if (match(v, /T[0-9][0-9][0-9][0-9]/)) tm = substr(v, RSTART+1, 2) ":" substr(v, RSTART+3, 2)
        next
      }
  ' \
  | sort \
  | jq -R -s -c 'split("\n") | map(select(length>0)) | map(split("\t"))
                 | map({kind:"event", title:(.[1] // ""), note:(.[0] // ""), status:"today"})' \
    2>/dev/null || echo "[]"
